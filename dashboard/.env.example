# Copy to dashboard/.env.local (gitignored). All server-side only: never NEXT_PUBLIC_.
# MOCK=1 serves contracts/fixtures (copied to mocks/) and never calls n8n.
MOCK=0
N8N_BASE_URL=http://localhost:5678
# Leave empty locally: the server falls back to the repo's root .env.
N8N_WEBHOOK_KEY=
DEMO_USER_ID=maya
