# Copy to .env (gitignored). Never commit real values.
N8N_BASE_URL=http://localhost:5678
# Shared secret for every LO webhook (header x-lo-key). Must match the
# "LO Webhook Key" credential in n8n (scripts/setup-instance.mjs creates it from this value).
# Any long random string; keep it local.
N8N_WEBHOOK_KEY=
DEMO_USER_ID=maya
# Optional. Leave empty: scripts/n8n.mjs uses the n8n CLI instead.
N8N_API_KEY=
